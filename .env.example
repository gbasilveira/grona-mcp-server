# Embed workspace secret from Grona Embed Settings > Secrets.
GRONA_API_KEY=
# Separate optional mobile key supplied by Grona. Never falls back to Embed key.
GRONA_MOBILE_API_KEY=
GRONA_AUTH_MODE=bearer
GRONA_BASE_URL=https://services.grona.ai/api/public/v1
GRONA_MOBILE_BASE_URL=https://api.grona.ai
GRONA_TIMEOUT_MS=30000
GRONA_VERIFY_TIMEOUT_MS=90000
GRONA_MAX_RETRIES=2
GRONA_MAX_RETRY_DELAY_MS=60000
